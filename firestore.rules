rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /practices/{uid} {
      allow read, write: if isOwner(uid);

      // Invoices are never deleted (credit invoices instead) and keep their number.
      match /invoices/{invoiceId} {
        allow read, create: if isOwner(uid);
        allow update: if isOwner(uid) && request.resource.data.number == resource.data.number;
        allow delete: if false;
      }

      match /{collection}/{docId} {
        allow read, write: if isOwner(uid) && collection != 'invoices';
      }
    }

    match /fiscalParameters/{year} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
