{
  "name": "boekhoud-software",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --project domain",
    "test:rules": "scripts/with-java.sh firebase emulators:exec --only firestore,storage \"vitest run --project rules\"",
    "emulators": "scripts/with-java.sh firebase emulators:start --import=.emulator-data --export-on-exit",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/seed-fiscal.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "@firebase/app-compat": "0.5.18",
    "@firebase/app": "0.16.2"
  }
}
